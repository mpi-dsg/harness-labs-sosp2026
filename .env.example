# Generated by preflight.sh -- shown here for reference only.
# OPENCLAW_GATEWAY_TOKEN: shared secret between CLI and gateway (random hex).
# DOCKER_SOCKET_PATH: active local Docker/Podman Unix socket.
# DOCKER_GID: socket GID as it appears inside a Linux container.
# HARNESS_STATE_DIR: absolute HOST path to ./state. The sandbox overlay mounts the
#   state directory at this same path inside the container, so the sibling-container
#   bind mount the runtime asks for resolves on the host daemon. Without it every
#   sandboxed tool call fails with "mounts denied".
OPENCLAW_GATEWAY_TOKEN=replace-me-run-preflight
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_GID=0
HARNESS_STATE_DIR=/absolute/path/to/harness-labs-sosp2026/state
